---
import './styles.css';
import './src/global-styles.css';
---

<!DOCTYPE html>
<html>
	<head>
		<title>Asian Nation</title>
	</head>
	<body>
		<header>
			<h1>Welcome to Asian Nation!</h1>
			<p>Welcome to Asian Nation, a small community that formed from a small group of friends.</p>
		</header>

		<div id="sections">
			<div id="blog">
				<a href="blog">
					<h2>Community Blog</h2>
					<p>The Asian Nation Blog is a space where people can post projects, updates, or anything, really.</p>
				</a>
			</div>

			<div id="music">
				<a id="music" href="music">
					<h2>Music of Asian Nation</h2>
					<p>A collection of songs that are made by the Asian Nation community.</p>
				</a>
			</div>

			<div id="minecraft">
				<a href="minecraft">
					<h2>Minecraft Server</h2>
					<p>Join the Asian Nation Minecraft Server, where you can play with friends and meet new people!</p>
				</a>
			</div>
		</div>

		<footer>
			<a href="https://discord.gg/9KXtEsAUvZ">
				discord
			</a>
		</footer>
	</body>
</html>